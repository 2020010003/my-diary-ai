# 오늘의 편지 환경변수 예시
# 이 파일을 복사해 .env (또는 .env.local)로 만들고 값을 채우세요. .env는 커밋 금지.
# 아래 두 설정 중 하나만 주석을 풀어 사용합니다.
# 값을 비워 두면 AI_BASE_URL, AI_MODEL은 Codyssey 기본값이 쓰이고,
# AI_API_KEY가 비어 있으면 CODYSSEY_API_KEY를 대신 읽습니다.

# ----------------------------------------
# 1) Codyssey 사용 (기본값)
# ----------------------------------------
AI_BASE_URL=https://copa.codyssey.kr/v1
AI_API_KEY=
AI_MODEL=gpt-5-mini

# ----------------------------------------
# 2) Gemini 사용 (OpenAI 호환 API)
#    키 발급: Google AI Studio
#    모델 예시 (2026-11 Google 공식 문서 기준)
#      gemini-3.6-flash  : Stable 표시된 flash 모델 (권장)
#      gemini-3.8-flash  : 최신(New) 모델, OpenAI 호환 문서 예제에서 사용
#    gemini-2.5-flash는 지원 종료 예정이라 쓰지 마세요.
# ----------------------------------------
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=
# AI_MODEL=gemini-3.6-flash

# ----------------------------------------
# Firebase Firestore (Long-term Memory 기능)
#   서비스 계정 JSON 파일 내용 전체를 한 줄 문자열로 넣으세요.
#   비워 두면 기억 기능만 꺼지고 편지 기능은 그대로 동작합니다.
# ----------------------------------------
FIREBASE_SERVICE_ACCOUNT=
