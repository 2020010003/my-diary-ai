/**
 * my-diary-ai
 * Google Sheets 알림 설정 저장 API
 *
 * 시트 컬럼:
 * user_id | email | alarm_time | enabled | timezone | last_sent_date
 */

// 구글 시트 연결
function getTargetSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheets()[0];

  const expectedHeaders = [
    "user_id",
    "email",
    "alarm_time",
    "enabled",
    "timezone",
    "last_sent_date"
  ];

  const actualHeaders = sheet
    .getRange(1, 1, 1, expectedHeaders.length)
    .getValues()[0];

  if (JSON.stringify(actualHeaders) !== JSON.stringify(expectedHeaders)) {
    throw new Error("구글 시트의 첫 번째 행 컬럼명이 올바르지 않습니다.");
  }

  return sheet;
}

// 프론트엔드에서 POST 요청을 받는 함수
function doPost(e) {
  const lock = LockService.getScriptLock();

  try {
    lock.waitLock(10000);

    // 전달받은 JSON 데이터
    const data = JSON.parse(e.postData.contents);

    const userId = String(data.user_id || "").trim();
    const email = String(data.email || "").trim();
    const alarmTime = String(data.alarm_time || "").trim();
    const enabled = data.enabled === true || data.enabled === "true";
    const timezone = String(data.timezone || "Asia/Seoul").trim();

    // 필수 데이터 확인
    if (!userId || !email || !alarmTime) {
      throw new Error("필수 정보가 누락되었습니다.");
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      throw new Error("올바른 이메일 주소를 입력해주세요.");
    }

    if (!/^([01]?\d|2[0-3]):[0-5]\d$/.test(alarmTime)) {
      throw new Error("알림 시간은 HH:mm 형식이어야 합니다.");
    }

    // 구글 시트 가져오기
    const sheet = getTargetSheet();
    const lastRow = sheet.getLastRow();

    // 기존 사용자 검색
    let targetRow = -1;

    if (lastRow >= 2) {
      const userIds = sheet
        .getRange(2, 1, lastRow - 1, 1)
        .getDisplayValues();

      for (let i = 0; i < userIds.length; i++) {
        if (userIds[i][0] === userId) {
          targetRow = i + 2;
          break;
        }
      }
    }

    // 기존 사용자라면 업데이트
    if (targetRow !== -1) {
      sheet.getRange(targetRow, 2, 1, 4).setValues([[
        email,
        alarmTime,
        enabled,
        timezone
      ]]);

    } else {
      // 신규 사용자라면 새 행 추가
      sheet.appendRow([
        userId,
        email,
        alarmTime,
        enabled,
        timezone,
        ""
      ]);
    }

    return ContentService
      .createTextOutput(JSON.stringify({
        success: true,
        message: "알림 설정이 저장되었습니다.",
        user_id: userId
      }))
      .setMimeType(ContentService.MimeType.JSON);

  } catch (error) {

    return ContentService
      .createTextOutput(JSON.stringify({
        success: false,
        message: error.message
      }))
      .setMimeType(ContentService.MimeType.JSON);

  } finally {
    if (lock.hasLock()) {
      lock.releaseLock();
    }
  }
}

// API 정상 작동 확인용
function doGet() {
  return ContentService
    .createTextOutput(JSON.stringify({
      success: true,
      message: "my-diary-ai API is running."
    }))
    .setMimeType(ContentService.MimeType.JSON);
}


function testSave() {
  const mockEvent = {
    postData: {
      contents: JSON.stringify({
        user_id: "test-user-123",
        email: "test@example.com",
        alarm_time: "21:30",
        enabled: true,
        timezone: "Asia/Seoul"
      })
    }
  };
  doPost(mockEvent);
}
